    {
      "name": "Order Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Response has JSON content-type\", function () {\n    pm.response.to.have.header(\"Content-Type\");\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\n});\n\npm.test(\"Response body has 'created' field set to true\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"created\");\n    pm.expect(jsonData.created).to.be.true;\n});\n\npm.test(\"Response body has a valid 'orderId' string\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"orderId\");\n    pm.expect(jsonData.orderId).to.be.a(\"string\");\n    pm.expect(jsonData.orderId).to.not.be.empty;\n});\n\n// Store orderId for use in follow-up requests (e.g. GET /orders/:orderId)\nvar jsonData = pm.response.json();\nif (jsonData.orderId) {\n    pm.environment.set(\"orderId\", jsonData.orderId);\n}"
            ]
          }
        }
      ],
